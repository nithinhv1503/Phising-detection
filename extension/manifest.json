{
  "manifest_version": 3,
  "name": "AI Phishing Sentinel - Browser Protection",
  "version": "1.0.0",
  "description": "Real-time AI-powered phishing website detection, warning interstitials, and zero-day threat protection.",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Phishing Sentinel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
